# Server-only. Never prefix with NEXT_PUBLIC_. Set in .env.local / Vercel, never commit values.

# Dedicated Printcom Neon database only.
DATABASE_URL=

# Lead notification emails (Titan SMTP, smtp.titan.email:465 SSL).
# Full mailbox used to authenticate AND as the From address.
LEAD_SMTP_USER=
LEAD_SMTP_PASSWORD=
# Where new-lead notifications are delivered.
LEAD_NOTIFY_TO=
